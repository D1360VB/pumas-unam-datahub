---
const { title = "Pumas UNAM Datahub" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <style>
      :root {
        /* Modo claro (predeterminado) */
        --bg-primary: #ffffff;
        --bg-secondary: #f5f5f5;
        --text-primary: #222222;
        --text-secondary: #666666;
        --border-color: #dddddd;
        --header-bg: #003087;
        --header-text: #ffffff;
        --table-stripe: #f5f5f5;
        --azul: #003087;
        --oro: #FDB913;
      }

      [data-theme="dark"] {
        /* Modo oscuro */
        --bg-primary: #121212;
        --bg-secondary: #1e1e1e;
        --text-primary: #e0e0e0;
        --text-secondary: #999999;
        --border-color: #333333;
        --header-bg: #001a4d;
        --header-text: #e0e0e0;
        --table-stripe: #1a1a1a;
        --azul: #001a4d;
        --oro: #FDB913;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        transition: background-color 0.3s ease, color 0.3s ease;
        font-family: "Silkscreen", system-ui, -apple-system, sans-serif;
        line-height: 1.6;
      }

      /* --- Header con layout flex --- */
      header {
        background: var(--header-bg);
        color: var(--header-text);
        padding: 1rem 2rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        transition: background-color 0.3s ease;
      }

      /* Logo + título */
      .logo-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--header-text);
        text-decoration: none;
        font-weight: 600;
        font-size: 1.1rem;
      }
      .logo-link:hover { color: var(--oro); }

      .logo {
        display: block;
        width: 48px;
        height: 48px;
        object-fit: contain;
      }
      .logo-dark { display: none; }
      [data-theme="dark"] .logo-light { display: none; }
      [data-theme="dark"] .logo-dark { display: block; }
      
      
      .clarity-city-<uniquifier> {
        font-family: "Clarity City", sans-serif;
        font-optical-sizing: auto;
        font-weight: <weight>;
        font-style: normal;
      }
      
      .silkscreen-regular {
        font-family: "Silkscreen", sans-serif;
        font-weight: 400;
        font-style: normal;
      }

      .silkscreen-bold {
        font-family: "Silkscreen", sans-serif;
        font-weight: 700;
        font-style: normal;
      }


      /* Nav alineado a la derecha */
      nav {
        display: flex;
        gap: 1.5rem;
        margin-left: auto;
      }
      nav a {
        color: var(--header-text);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
      }
      nav a:hover { color: var(--oro); }

      /* Botón de tema */
      .theme-toggle {
        background: transparent;
        border: 1px solid var(--header-text);
        border-radius: 50%;
        width: 40px;
        height: 40px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        transition: background-color 0.2s, border-color 0.2s;
        color: var(--header-text);
      }
      .theme-toggle:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: var(--oro);
      }

      /* Contenido principal */
      main {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
      }

      h1, h2, h3 {
        font-family: "Silkscreen", system-ui, sans-serif;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 1rem;
      }
      h1, h2 { color: var(--azul); }
      [data-theme="dark"] h1,
      [data-theme="dark"] h2 { color: var(--oro); }

      /* Tablas */
      table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
      th, td { padding: 0.5rem 0.75rem; text-align: left; border-bottom: 1px solid var(--border-color); }
      th { background: var(--header-bg); color: var(--header-text); }
      tr:nth-child(even) { background: var(--table-stripe); }

      /* Footer */
      footer {
        text-align: center;
        padding: 2rem;
        color: var(--text-secondary);
        font-size: 0.875rem;
      }
            /* ============================================
         RESPONSIVE — Tablet (≤ 1024px)
         ============================================ */
      @media (max-width: 1024px) {
        header {
          padding: 0.75rem 1rem;
          gap: 1rem;
        }
        nav {
          gap: 1rem;
        }
        main {
          padding: 0 0.75rem;
        }
      }

      /* ============================================
         RESPONSIVE — Móvil (≤ 768px)
         ============================================ */
      @media (max-width: 768px) {
        header {
          padding: 0.75rem 1rem;
          flex-wrap: wrap;
          gap: 0.75rem;
        }

        /* El logo-link ocupa el ancho completo en la primera fila */
        .logo-link {
          flex: 1 1 100%;
          justify-content: flex-start;
        }
        .logo {
          width: 40px;
          height: 40px;
        }

        /* El nav pasa a la segunda fila, ocupando todo el ancho */
        nav {
          flex: 1 1 auto;
          margin-left: 0;
          gap: 0.75rem;
          justify-content: space-around;
          order: 3;
          flex-basis: 100%;
          border-top: 1px solid rgba(255, 255, 255, 0.15);
          padding-top: 0.75rem;
        }
        nav a {
          font-size: 0.9rem;
          padding: 0.25rem 0.5rem;
        }

        /* El botón de tema se mantiene a la derecha */
        .theme-toggle {
          width: 36px;
          height: 36px;
          font-size: 1rem;
          margin-left: auto;
        }

        main {
          padding: 0 0.75rem;
          margin: 1.5rem auto;
        }

        h1 { font-size: 1.5rem; }
        h2 { font-size: 1.25rem; }

        /* Tablas: scroll horizontal en lugar de desbordarse */
        .table-wrapper {
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          margin: 1rem -0.75rem;   /* sale del padding del main */
          padding: 0 0.75rem;
        }
        table {
          min-width: 600px;        /* fuerza scroll en lugar de aplastar columnas */
          font-size: 0.875rem;
        }
        th, td {
          padding: 0.4rem 0.5rem;
          white-space: nowrap;
        }
      }

      /* ============================================
         RESPONSIVE — Móvil pequeño (≤ 480px)
         ============================================ */
      @media (max-width: 480px) {
        .logo-link span {
          font-size: 1rem;
        }
        nav a {
          font-size: 0.85rem;
        }
        h1 { font-size: 1.3rem; }
        body { font-size: 0.95rem; }
      }
    </style>
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('pumas-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
      
      document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('theme-toggle');
        const html = document.documentElement;
        
        const updateIcon = () => {
          const isDark = html.getAttribute('data-theme') === 'dark';
          toggle.querySelector('.theme-icon-light').style.display = isDark ? 'none' : 'inline';
          toggle.querySelector('.theme-icon-dark').style.display = isDark ? 'inline' : 'none';
        };
        
        updateIcon();
        
        toggle.addEventListener('click', () => {
          const current = html.getAttribute('data-theme');
          const next = current === 'dark' ? 'light' : 'dark';
          html.setAttribute('data-theme', next);
          localStorage.setItem('pumas-theme', next);
          updateIcon();
        });
      });
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Clarity+City:ital,wght@0,100..900;1,100..900&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
  <header>
    <a href={import.meta.env.BASE_URL + "/"} class="logo-link">
      <img 
        src={import.meta.env.BASE_URL + "/logo-light.svg"} 
        alt="Pumas Datahub" 
        class="logo logo-light"
        width="80"
        height="80"
      />
      <img 
        src={import.meta.env.BASE_URL + "/logo-dark.svg"} 
        alt="Pumas Datahub" 
        class="logo logo-dark"
        width="80"
        height="80"
      />
      <span>Pumas Datahub</span>
    </a>
    <nav>
      <a href={import.meta.env.BASE_URL + "/partidos"}>Partidos</a>
      <a href={import.meta.env.BASE_URL + "/temporadas"}>Temporadas</a>
      <a href={import.meta.env.BASE_URL + "/rivales"}>Rivales</a>
    </nav>
    <button id="theme-toggle" class="theme-toggle" aria-label="Cambiar tema">
      <span class="theme-icon-light">☀️</span>
      <span class="theme-icon-dark">🌙</span>
    </button>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    Datos abiertos de Pumas UNAM · Liga MX
  </footer>
</body>
</html>
